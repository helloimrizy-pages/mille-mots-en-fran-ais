# Anthropic (for enrichment — Task 18)
ANTHROPIC_API_KEY=

# Google Cloud TTS — path to a service account JSON with TTS enabled (Tasks 20, 21)
GOOGLE_APPLICATION_CREDENTIALS=./gcp-sa.json

# Firebase (public by design — these identify the project, they do not
# authorise anything; access is controlled by firestore.rules).
# Get these from Firebase console → Project settings → Your apps → Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
